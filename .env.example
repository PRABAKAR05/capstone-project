# ==============================================================================
# CareBridge AI — Master Environment Configuration Template
# ==============================================================================
# Copy this template to .env or .env.local in your service directories.
# NEVER commit .env or any secret keys to Git.
# ==============================================================================

# Application Environment Mode: development | staging | production
ENVIRONMENT=development
DEBUG=true

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Supabase & PostgreSQL Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Frontend Application Configuration (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# ------------------------------------------------------------------------------
# Clinical NLP & LLM Services (Groq)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# CSCM-IoMT Edge Microservice Configuration
# ------------------------------------------------------------------------------
CSCM_SERVICE_URL=http://127.0.0.1:8001
CSCM_MODEL_DEVICE=cpu
