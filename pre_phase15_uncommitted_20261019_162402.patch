+        
+    @staticmethod
+    def get_wesad_edges() -> List[Tuple[str, str]]:
+        """
+        Returns the undirected physiological edges for WESAD.
+        Maintains cross-device relationships (Chest <-> Wrist).
+        """
+        return [
+            ("chest_ECG", "wrist_BVP"),
+            ("chest_EDA", "wrist_EDA"),
+            ("chest_ACC_0", "wrist_ACC_0"),
