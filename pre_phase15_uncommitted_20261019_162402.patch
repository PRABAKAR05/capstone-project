+2. CSCM Graph Message Passing Logic
+# 3. Cross-Sensor Consistency Graph Message Passing
+E = self.edge_index.shape[1]
+
+if E > 0:
+    src_idx = self.edge_index[0]  # Source nodes
+    dst_idx = self.edge_index[1]  # Target nodes
+    
+    # Extract temporal embeddings for edge endpoints
+    z_src = z[:, src_idx, :]  # (B, E, 256)
+    z_dst = z[:, dst_idx, :]  # (B, E, 256)
+    
+    # Compute relation features r_ij using PairwiseConsistencyModule
+    r_ij = self.consistency_module(z_src, z_dst)  # (B, E, relation_dim)
+    
+    # Aggregate relations for each target node
+    aggregated_relations = torch.zeros(B, C, r_ij.shape[-1], device=x.device, dtype=r_ij.dtype)
+    
+    # Expand dst_idx to match dimensions and scatter-add relationships
+    scatter_idx = dst_idx.unsqueeze(0).unsqueeze(-1).expand(B, E, r_ij.shape[-1])
+    aggregated_relations.scatter_add_(dim=1, index=scatter_idx, src=r_ij)
+    
+    # 4. Node Update with Residual Connection
+    z_concat = torch.cat([z, aggregated_relations], dim=-1)  
+    z_updated = self.node_update(z_concat)  
+    z = z + z_updated
+
