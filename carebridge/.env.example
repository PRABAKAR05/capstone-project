# CareBridge AI - Environment Variables Template
# Copy this file to .env or .env.local and fill in the values.
# NEVER commit .env or secrets to Git.

# Environment Mode: development | staging | production
ENVIRONMENT=development
DEBUG=true

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Configuration
SUPABASE_URL=https://vmuzexvtbodnkzhfitzf.supabase.co
SUPABASE_KEY=your_supabase_publishable_or_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.vmuzexvtbodnkzhfitzf.supabase.co:5432/postgres

# Groq LLM Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# CSCM Service URL
CSCM_SERVICE_URL=http://127.0.0.1:8001
